Screen {
    background: $surface;
}

#statusbar {
    height: 3;
    padding: 1 2 0 2;
    background: $panel;
    color: $text;
    border-bottom: solid $primary;
}

#body {
    height: 1fr;
}

#left {
    width: 42;
    height: 1fr;
    padding: 1;
    border: round $primary;
    margin-right: 1;
}

#right {
    width: 1fr;
    height: 1fr;
    padding: 1;
    border: round $primary;
}

.section {
    text-style: bold;
    color: $accent;
    height: 1;
    margin-bottom: 1;
}

.inlabel {
    width: 5;
    height: 3;
    padding: 1 0 0 0;
    color: $text-muted;
}

.hint {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

/* -- D-pad -- */

#dpad {
    grid-size: 3 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 3 3 3;
    grid-gutter: 1;
    height: 11;
}

#dpad Button {
    width: 100%;
    height: 3;
    min-width: 0;
    content-align: center middle;
}

#dpad .blank {
    width: 100%;
}

/* -- button rows -- */

.row {
    height: 3;
    margin-top: 1;
}

.row Button {
    width: 1fr;
    height: 3;
    min-width: 0;
    margin-right: 1;
    padding: 0;
    content-align: center middle;
}

/* -- tabs -- */

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 1;
}

#app-search {
    margin-bottom: 1;
}

#app-scroll {
    height: 1fr;
    border: round $panel;
}

#app-grid {
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    grid-rows: auto;
    height: auto;
}

#app-grid Button {
    width: 100%;
    height: 3;
    min-width: 0;
    padding: 0;
    content-align: center middle;
}

#custom-app {
    height: 4;
    margin-top: 1;
}

#custom-app Input {
    width: 1fr;
}

#custom-app Button {
    width: 14;
    margin-left: 1;
}

#text-row {
    height: 4;
    margin-top: 1;
}

#text-row Input {
    width: 1fr;
}

#text-row Button {
    width: 14;
    margin-left: 1;
}

#device-detail {
    height: auto;
}

#log {
    height: 1fr;
    border: round $panel;
}

#clear-log {
    width: 16;
    margin-top: 1;
}

/* -- service tab -- */

.warn {
    color: $error;
    height: auto;
    margin-bottom: 1;
}

#sequence-row {
    height: 4;
}

#sequence-row Input {
    width: 1fr;
}

#sequence-row Button {
    width: 10;
    margin-left: 1;
}

/* -- confirmation modal -- */

ConfirmScreen {
    align: center middle;
}

#confirm-box {
    width: 68;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $panel;
}

#confirm-message {
    height: auto;
    margin-bottom: 1;
}

#confirm-actions {
    height: 4;
    margin-top: 1;
}

#confirm-actions Button {
    width: 1fr;
    margin-right: 1;
}

/* -- discovery modal -- */

DiscoveryScreen {
    align: center middle;
}

#discovery-box {
    width: 82;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $panel;
}

#discovery-title {
    height: auto;
    margin-bottom: 1;
}

#discovery-list {
    height: auto;
    max-height: 18;
}

.tv-btn {
    width: 100%;
    margin-bottom: 1;
}

#discovery-cancel {
    width: 100%;
    margin-top: 1;
}


